+    /**
+     * MaiSim (patch 0009): the branch currents at t = 0, from the initial potentials (the caller sets p = pALT), written
+     * only to the components' current (no matrix, switching or diode state is touched): resistive elements (R, Rth,
+     * switches, diodes, thyristors, IGBTs in their present state) by Ohm's law, inductors their initial current, voltage
+     * sources the current of the initial solution, current sources their value at t, capacitors the current of Gecko's
+     * initial solution (the DC source that stood for a capacitor with uC(0), or the capacitor itself in that 1 ns step).
+     */
+    public void setInitialCurrents(final double t) {
+        for (int i1 = 0; i1 < elementANZAHL; i1++) {
+            final int x = netzliste.knotenX[i1];
+            final int y = netzliste.knotenY[i1];
+            final double[] par = netzliste.parameter[i1];
+            final ch.technokrat.gecko.geckocircuits.circuit.circuitcomponents.AbstractCircuitBlockInterface e = netzliste.eLKneu[i1];
+            switch (netzliste.typ[i1]) {
+                case REL_RELUCTANCE:
+                case LK_R:
+                case TH_RTH:
+                case TH_AMBIENT:
+                case LK_S:
+                case LK_MOSFET:
+                    e._currentInAmps = (p[x] - p[y]) / (par[0] < FAST_NULL_R ? FAST_NULL_R : par[0]);
+                    break;
+                case LK_L:
+                case NONLIN_REL:
+                    e._currentInAmps = iALT[i1];
+                    break;
+                case LK_D:
+                case LK_THYR:
+                case LK_IGBT:
+                    e._currentInAmps = ((p[x] - p[y]) - par[1]) / par[0];
+                    break;
+                case LK_I:
+                case TH_FLOW:
+                    if ((int) par[0] == SourceType.QUELLE_SIN_NEW || (int) par[0] == SourceType.QUELLE_SIN) {
+                        e._currentInAmps = par[20] * Math.sin(2 * Math.PI * par[2] * t - Math.toRadians(par[4])) + par[3];
+                    } else if ((int) par[0] == SourceType.QUELLE_VOLTAGECONTROLLED_DIRECTLY_NEW
+                            || (int) par[0] == SourceType.QUELLE_VOLTAGECONTROLLED_DIRECTLY) {
+                        e._currentInAmps = 0;
+                    } else {
+                        e._currentInAmps = par[1];
+                    }
+                    break;
+                case LK_U:
+                case REL_MMF:
+                case TH_TEMP:
+                case LK_LKOP2:
+                    e._currentInAmps = p[netzliste.knotenMAX + netzliste.spgQuelleNr[i1]];
+                    break;
+                case LK_C:
+                case TH_CTH:
+                    if (_pInitMaiSim != null && _netzInitMaiSim != null && i1 < _netzInitMaiSim.typ.length) {
+                        if (_netzInitMaiSim.typ[i1] == ch.technokrat.gecko.geckocircuits.circuit.circuitcomponents.CircuitTyp.LK_U) {
+                            e._currentInAmps = _pInitMaiSim[_netzInitMaiSim.knotenMAX + _netzInitMaiSim.spgQuelleNr[i1]];
+                        } else {
+                            e._currentInAmps = par[0] / 1e-9 * (_pInitMaiSim[x] - _pInitMaiSim[y]);
+                        }
+                    } else {
+                        e._currentInAmps = 0;
+                    }
+                    break;
+                default:
+                    break;
+            }
+        }
+    }
