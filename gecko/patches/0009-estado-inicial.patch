+    /** A FLOW on the losses of a Pv: nothing has been dissipated before the first step (the loss calculation keeps the
+     *  last value of the previous run until then), so its value at t = 0 is 0. */
+    private static boolean isLossFlow(final RegelBlock block) {
+        return block instanceof ReglerFlowMeter && ((ReglerFlowMeter) block).getComponentCoupling()._coupledElements[0]
+                instanceof ch.technokrat.gecko.geckocircuits.circuit.circuitcomponents.ThermPvChip;
+    }
+
+    /** The outputs at t = 0 (see GeckoRemoteInterface.initialOutputs): after initSimulation, without a step. */
+    @Override
+    public final double[] initialOutputs(final String[] elementNames) {
+        if (!_simInited) {
+            initSimulation();
+        }
+        final String[] outputs = new String[elementNames.length];
+        final RegelBlock[] blocks = controlBlocks(elementNames, outputs);
+        _circuit.evaluateInitialState();
+        final double[] result = new double[elementNames.length];
+        try {
+            for (int i = 0; i < blocks.length; i++) {
+                final double v = isLossFlow(blocks[i]) ? 0.0 : outputs[i] == null ? blocks[i].getOutput() : blocks[i].getOutput(outputs[i]);
+                result[i] = Double.isFinite(v) ? v : 0.0;
+            }
+        } catch (IllegalAccessException e) {
+            writerOutputErrorLn(e.getMessage());
+            throw new RuntimeException(e);
+        }
+        return result;
+    }
