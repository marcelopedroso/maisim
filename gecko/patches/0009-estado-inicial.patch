+    /**
+     * MaiSim: the outputs at t = 0, before any step — the initial state with the circuit's initial conditions (the node
+     * potentials and temperatures Gecko solves at initSimulation from uC(0), Temp(0)…, the machine quantities as
+     * initialized) and the branch currents from it (LKMatrices.setInitialCurrents), passed to the measurement blocks, and
+     * the control blocks evaluated once at t = 0 with a zero step (an
+     * integrator gives y0, a source its value at 0). Not a simulation step: the state it touches is thrown away by the
+     * initSimulation that follows (the caller initializes again before stepping).
+     */
+    public void evaluateInitialState() {
+        if (simuliereLeistungskreis) {
+            System.arraycopy(lkmLK.pALT, 0, lkmLK.p, 0, Math.min(lkmLK.p.length, lkmLK.pALT.length));
+            lkmLK.setInitialCurrents(t);
+            dataTransferLK_Control();
+        }
+        if (simuliereThermKreis) {
+            System.arraycopy(lkmTHERM.pALT, 0, lkmTHERM.p, 0, Math.min(lkmTHERM.p.length, lkmTHERM.pALT.length));
+            lkmTHERM.setInitialCurrents(t);
+            dataTransferTherm();
+        }
+        if (simuliereRegelkreis) {
+            try {
+                controlNL.berechneZeitschritt(0.0, t);
+            } catch (Exception ex) {  // as simulateSteps: not thrown here; a block that cannot be calculated (a Data
+                // from File without data) fails again when its output is read, and the caller leaves that signal out
+                System.err.println("evaluateInitialState(): " + ex.getMessage());
+            }
+        }
+    }
