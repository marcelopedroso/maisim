+    /** The control blocks of names ("block@output" for a named output; null in outputs means the single output). */
+    private RegelBlock[] controlBlocks(final String[] names, final String[] outputs) {
+        final RegelBlock[] blocks = new RegelBlock[names.length];
+        for (int i = 0; i < names.length; i++) {
+            final int at = names[i].lastIndexOf('@');
+            final String name = at > 0 ? names[i].substring(0, at) : names[i];
+            outputs[i] = at > 0 ? names[i].substring(at + 1) : null;
+            final AbstractBlockInterface block = IDStringDialog.getComponentByName(name);
+            if (!(block instanceof RegelBlock)) {
+                writerOutputErrorLn("Error, selected component is not a control block!");
+                throw new RuntimeException("Error, selected component is not a control block: " + name);
+            }
+            blocks[i] = (RegelBlock) block;
+        }
+        return blocks;
+    }
+
