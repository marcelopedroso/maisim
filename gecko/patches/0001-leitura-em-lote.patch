+    /**
+     * batch version of getOutput(String): one remote call for several control blocks
+     */
+    @Override
+    public final double[] getOutputs(final String[] elementNames) {
+        final double[] values = new double[elementNames.length];
+        for (int i = 0; i < elementNames.length; i++) {
+            values[i] = getOutput(elementNames[i]);
+        }
+        return values;
+    }
+
+    /**
+     * batch version of setParameter: one remote call for several (element, parameter, value) entries
+     */
+    @Override
+    public final void setParameterMany(final String[] elementNames, final String[] parameterNames, final double[] values) {
+        if (elementNames.length != parameterNames.length || elementNames.length != values.length) {
+            throw new IllegalArgumentException("setParameterMany: the three arrays must have the same length");
+        }
+        for (int i = 0; i < elementNames.length; i++) {
+            setParameter(elementNames[i], parameterNames[i], values[i]);
+        }
+    }
