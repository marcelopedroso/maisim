+        }
+    };
+
+    private static RMIServerSocketFactory fabricaServidor() {
+        try {
+            return InetAddress.getByName(_ipAddress).isLoopbackAddress() ? SO_LOCAL : null;
+        } catch (IOException e) {
+            return null;
+        }
+    }
