+    // MaiSim (patch 0010): the run with the control in Python, one remote call per sample period (stepControl)
+    private RegelBlock[] _ctlPoints, _ctlAverages;
+    private String[] _ctlPointOutputs, _ctlAverageOutputs;
+    private AbstractBlockInterface[] _ctlConsts;
+
+    /** The names stepControl reads, averages and writes, resolved once (see GeckoRemoteInterface.prepareControlSteps). */
+    @Override
+    public final void prepareControlSteps(final String[] pointNames, final String[] averageNames, final String[] constNames) {
+        final String[] pointOutputs = new String[pointNames.length], averageOutputs = new String[averageNames.length];
+        final RegelBlock[] points = controlBlocks(pointNames, pointOutputs);
+        final RegelBlock[] averages = controlBlocks(averageNames, averageOutputs);
+        final AbstractBlockInterface[] consts = new AbstractBlockInterface[constNames.length];
+        for (int i = 0; i < constNames.length; i++) {
+            consts[i] = IDStringDialog.getComponentByName(constNames[i]);
+        }
+        _ctlPoints = points;
+        _ctlPointOutputs = pointOutputs;
+        _ctlAverages = averages;
+        _ctlAverageOutputs = averageOutputs;
+        _ctlConsts = consts;
+    }
+
+    /**
+     * One sample period (see GeckoRemoteInterface.stepControl): the same steps, writes, means and readings as
+     * simulateSteps / simulateStepsAveraged, setParameter(…, "const", …) and getOutputs called one by one.
+     */
+    @Override
+    public final double[] stepControl(final int steps, final int[] offsets, final int[] constIndex, final double[] values) {
+        if (_ctlConsts == null) {
+            throw new IllegalStateException("stepControl() before prepareControlSteps()");
+        }
+        if (!_simInited) {
+            initSimulation();
+            writeOutputLn("Warning: Simulation was not initialized prior to calling stepControl(). "
+                    + "Simulation has been initialized to values specified in GeckoCIRCUITS.");
+        }
+        final int na = _ctlAverages.length, np = _ctlPoints.length, w = 2 + na;
+        final double[] stretches = new double[(offsets.length + 1) * w];
+        int nStretches = 0, done = 0, k = 0;
+        try {
+            while (true) {
+                final int next = k < offsets.length ? offsets[k] : steps;
+                if (next > done) {                    // the steps up to the next write (or to the end): one stretch
+                    controlStretch(next - done, stretches, nStretches * w);
+                    nStretches++;
+                    done = next;
+                }
+                if (k >= offsets.length) {
+                    break;
+                }
+                final int at = offsets[k];
+                for (; k < offsets.length && offsets[k] == at; k++) {   // the writes before step "at", in their order
+                    _ctlConsts[constIndex[k]].setAccessibleParameter("const", values[k]);
+                }
+            }
+            final double[] result = new double[1 + nStretches * w + np];
+            result[0] = nStretches;
+            System.arraycopy(stretches, 0, result, 1, nStretches * w);
+            for (int i = 0; i < np; i++) {
+                result[1 + nStretches * w + i] = _ctlPointOutputs[i] == null ? _ctlPoints[i].getOutput() : _ctlPoints[i].getOutput(_ctlPointOutputs[i]);
+            }
+            return result;
+        } catch (IllegalAccessException e) {
+            writerOutputErrorLn(e.getMessage());
+            throw new RuntimeException(e);
+        }
+    }
+
+    /** q steps as simulateSteps (or simulateStepsAveraged, with averages): {time at the end, steps done, means} at base. */
+    private void controlStretch(final int q, final double[] out, final int base) throws IllegalAccessException {
+        final int na = _ctlAverages.length;
+        final double[] sum = new double[na];
+        int done = 0;
+        try {
+            for (; done < q; done++) {
+                _circuit.simulateOneStep();
+                for (int i = 0; i < na; i++) {
+                    sum[i] += _ctlAverageOutputs[i] == null ? _ctlAverages[i].getOutput() : _ctlAverages[i].getOutput(_ctlAverageOutputs[i]);
+                }
+            }
+        } catch (IllegalAccessException e) {
+            throw e;
+        } catch (Exception ex) {                      // as simulateSteps / simulateStepsAveraged: reported, not thrown
+            writerOutputErrorLn((na > 0 ? "simulateStepsAveraged(): " : "simulateSteps(): ") + ex.getMessage());
+        }
+        out[base] = getSimulationTime();
+        out[base + 1] = done;
+        for (int i = 0; i < na; i++) {
+            out[base + 2 + i] = done > 0 ? sum[i] / done : 0.0;
+        }
+    }
