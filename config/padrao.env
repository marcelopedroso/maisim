# MaiSim — portas e pastas (o padrão). Para mudar na sua máquina, crie um .env na raiz do projeto (fica fora do git)
# só com o que muda, no mesmo formato: NOME=valor. O que já estiver no ambiente vale mais que os arquivos.
# ~ (ou $HOME) no começo vira a sua pasta pessoal; $RAIZ, a raiz do projeto.

# portas (todas só em localhost)
MAISIM_PORTA_PAGINA=7100        # a página: http://localhost:7100 (Vite; encaminha /maisim/simu, /maisim/scope, /maisim/gecko)
MAISIM_PORTA_SIMU=7101          # o simulador: editor, controle, IA
MAISIM_PORTA_SCOPE=7102         # o scope: rodadas e medição
MAISIM_PORTA_GECKO=7103         # o GeckoCIRCUITS (interface remota)
MAISIM_PORTA_MOTOR=7104         # o motor do editor (entre o simulador e o Gecko)
MAISIM_PORTA_TELA=7105          # a tela do Gecko no navegador (noVNC)
MAISIM_PORTA_VNC=7106           # o VNC da tela virtual (interno; o navegador usa a 7105)
MAISIM_TELA_X=:71               # a tela virtual (Xvfb) onde o Gecko roda

# pastas
MAISIM_DADOS=~/.local/share/maisim       # o que é seu: circuitos/, subcircuitos/, rodadas/, contextos/
MAISIM_CACHE=~/.cache/maisim             # o que dá para refazer: o estado do editor, as conversas, o Gecko, os registros
MAISIM_CLAUDE_DIR=~/.claude-maisim       # o login do Claude Code usado pelo MaiSim
MAISIM_AGY_DIR=~/.agy-maisim             # o login do Google Antigravity usado pelo MaiSim
MAISIM_GEMINI_DIR=~/.gemini-maisim       # o login do Gemini CLI (só com MAISIM_GEMINI_CLI=1)
MAISIM_PASTAS_CIRCUITOS=                 # outras pastas com circuitos (.ipes), separadas por ":"; "nome=pasta" dá o nome do grupo
MAISIM_EXEMPLOS_GECKO=0                  # 1: os exemplos que vêm com o GeckoCIRCUITS no "Abrir" (nem todos rodam no MaiSim)
MAISIM_SCOPE_PASTAS=                     # outras pastas onde o scope procura gravações (scope_*.npz), separadas por ":"
