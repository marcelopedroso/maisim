# MaiSim — o perfil de teste (MAISIM_PERFIL=teste): por cima do padrao.env; o .env da raiz NÃO vale aqui.
# A instância de teste nunca usa os logins nem os dados de verdade: tudo em ~/.cache/maisim_teste (desce_teste.sh apaga
# os logins de mentira) e as IAs de mentira (validacao/*_falso.py). Os testes usam estas portas.
MAISIM_PORTA_PAGINA=7200
MAISIM_PORTA_SIMU=7201
MAISIM_PORTA_SCOPE=7202
MAISIM_PORTA_GECKO=7203
MAISIM_PORTA_MOTOR=7204
MAISIM_PORTA_TELA=7205
MAISIM_PORTA_VNC=7206
MAISIM_TELA_X=:72
MAISIM_PORTA_PAGINA_ISOLADA=7210         # a instância isolada dos testes do scope ao vivo (sobe_fila.sh): a página…
MAISIM_PORTA_SCOPE_ISOLADO=7211          # …e o scope dela (só memória)

MAISIM_DADOS=~/.cache/maisim_teste
MAISIM_CACHE=~/.cache/maisim_teste/cache
MAISIM_SIMU_CACHE=~/.cache/maisim_teste
MAISIM_SALVOS=~/.cache/maisim_teste/circuitos          # explícitas (o padrão seria o mesmo, sob MAISIM_DADOS): os testes
MAISIM_BIBLIOTECA=~/.cache/maisim_teste/subcircuitos   # leem estas pastas no ambiente do servidor de teste
MAISIM_RODADAS=~/.cache/maisim_teste/rodadas
MAISIM_CONTEXTOS=~/.cache/maisim_teste/contextos
MAISIM_CLAUDE_DIR=~/.cache/maisim_teste/claude-maisim
MAISIM_CURSOR_DIR=~/.cache/maisim_teste/cursor-maisim
MAISIM_CLAUDE_BIN=$RAIZ/simu/validacao/claude_falso.py
MAISIM_DEEPSEEK_DIR=~/.cache/maisim_teste/deepseek-maisim
MAISIM_DEEPSEEK_SEM_REDE=1               # nenhuma chamada à DeepSeek (a chave de mentira não é conferida, nem o saldo)
MAISIM_CURSOR_BIN=$RAIZ/simu/validacao/cursor_falso.py
MAISIM_IA_TESTE=1
MAISIM_PUBLICA_SCOPE=http://127.0.0.1:9  # o simulador de teste não publica rodadas em scope nenhum
MAISIM_SCOPE_PASTAS=$RAIZ/simu/validacao
MAISIM_RELEASES_URL=$RAIZ/simu/validacao/dados/releases_teste.json   # as releases de mentira (a atualização: nada do GitHub)
